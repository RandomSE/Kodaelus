{
  "name": "kodaelus",
  "version": "0.1.0",
  "private": true,
  "description": "Kodaelus agent distribution: install once, use in every project.",
  "author": "Joshua Grace",
  "license": "LicenseRef-Kodaelus-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RandomSE/Kodaelus.git"
  },
  "scripts": {
    "install:global": "node install/install.mjs",
    "uninstall:global": "node install/install.mjs --uninstall",
    "test:hooks": "node scripts/run-node-tests.mjs install/hooks",
    "test:install": "node scripts/run-node-tests.mjs install/lib",
    "test": "npm run test:hooks && npm run test:install"
  },
  "engines": {
    "node": ">=20"
  }
}
