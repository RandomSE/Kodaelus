{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/kodaelus-session.mjs"
      },
      {
        "command": "node ./hooks/scope-creep-guard.mjs",
        "matcher": "UserPromptSubmit"
      }
    ],
    "subagentStart": [
      {
        "command": "node ./hooks/kodaelus-session.mjs",
        "matcher": "kodaelus"
      }
    ],
    "sessionEnd": [
      {
        "command": "node ./hooks/kodaelus-session.mjs"
      }
    ],
    "preToolUse": [
      {
        "command": "node ./hooks/scope-creep-guard.mjs",
        "matcher": "Write|StrReplace|Delete|ApplyPatch|MCP"
      },
      {
        "command": "node ./hooks/guard-patch-delete.mjs",
        "matcher": "ApplyPatch",
        "failClosed": true
      },
      {
        "command": "node ./hooks/guard-delete.mjs",
        "matcher": "Delete",
        "failClosed": true
      },
      {
        "command": "node ./hooks/dash-guard.mjs",
        "matcher": "Write|StrReplace|ApplyPatch"
      },
      {
        "command": "node ./hooks/ask-question-guard.mjs",
        "matcher": "AskQuestion|AskUserQuestion"
      }
    ],
    "postToolUse": [
      {
        "command": "node ./hooks/manifest-verify.mjs",
        "matcher": "Delete|ApplyPatch"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node ./hooks/scope-creep-guard.mjs"
      },
      {
        "command": "node ./hooks/confidence-evidence-guard.mjs",
        "failClosed": true
      },
      {
        "command": "node ./hooks/dash-guard.mjs"
      },
      {
        "command": "node ./hooks/ask-question-guard.mjs"
      }
    ],
    "stop": [
      {
        "command": "node ./hooks/scope-creep-guard.mjs"
      },
      {
        "command": "node ./hooks/confidence-evidence-guard.mjs",
        "failClosed": true
      },
      {
        "command": "node ./hooks/dash-guard.mjs",
        "failClosed": true,
        "loop_limit": 3
      },
      {
        "command": "node ./hooks/ask-question-guard.mjs",
        "loop_limit": 2
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node ./hooks/block-git-when-kodaelus.mjs",
        "matcher": "\\bgit\\b|\\bgh\\s+(auth|repo|pr|issue|release|workflow)\\b"
      },
      {
        "command": "node ./hooks/block-readonly-shell.mjs"
      },
      {
        "command": "node ./hooks/block-delete-shell.mjs",
        "matcher": "\\brm\\b|\\brmdir\\b|\\bdel\\b|\\brd\\b|Remove-Item|\\bunlink\\b",
        "failClosed": true
      }
    ]
  }
}
